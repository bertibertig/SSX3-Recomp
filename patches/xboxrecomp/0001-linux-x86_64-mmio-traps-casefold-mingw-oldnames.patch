+/* Xbox file systems are case-insensitive (FATX, and XDVDFS on the disc), and
+ * so is the Win32 backend; a POSIX host file system is not. A title asks for
+ * D:\data\movies\intro_dj.mad and the extracted disc holds Intro_DJ.mad --
+ * SSX 3 does exactly that, and on Linux the intro video was "not found" while
+ * the same build under Proton played it.
+ *
+ * So when the exact host path does not exist, resolve each component after
+ * prefix_len (the game or save directory, which the runtime owns and whose
+ * spelling is right) against its directory, case-insensitively. The first
+ * component with no match ends the walk and the rest is left as given: that
+ * is a file being created, and it keeps the title's spelling. The common
+ * case -- the name already matches -- costs one stat. */
+static void casefold_resolve(char* path, size_t prefix_len)
+{
+    struct stat st;
+    char* comp;
+
+    if (stat(path, &st) == 0 || strlen(path) <= prefix_len)
+        return;
+    comp = path + prefix_len;
+    while (*comp == '/')
+        comp++;
+    while (*comp) {
+        char* slash = strchr(comp, '/');
+        if (slash)
+            *slash = '\0';
+        if (stat(path, &st) != 0) {
+            char* sep = comp - 1;           /* the '/' ending the parent */
+            DIR* d;
+            struct dirent* de;
+            int found = 0;
+
+            *sep = '\0';
+            d = opendir(path[0] ? path : "/");
+            *sep = '/';
+            if (d) {
+                while ((de = readdir(d)) != NULL) {
+                    if (strcasecmp(de->d_name, comp) == 0) {
+                        memcpy(comp, de->d_name, strlen(comp));
+                        found = 1;
+                        break;
+                    }
+                }
+                closedir(d);
+            }
+            if (!found) {
+                if (slash)
+                    *slash = '/';
+                return;
+            }
+        }
+        if (!slash)
+            return;
+        *slash = '/';
+        comp = slash + 1;
+    }
+}
