+/* The dispatch lock: DISPATCH_LEVEL as mutual exclusion against DPCs.
+ *
+ * On the Xbox's one CPU, a thread at DISPATCH_LEVEL or above cannot be
+ * interrupted by a DPC, and a DPC runs to completion before any thread does.
+ * The XDK relies on it: DirectSound's lock is a raise to DISPATCH_LEVEL (see
+ * irql_publish), and its register sequences -- select a voice with
+ * SET_CURRENT_VOICE, then write that voice's volumes -- are only atomic
+ * because its stream DPC cannot run in between. Here DPCs run on the timer
+ * thread while guest threads run on theirs, IRQL or not: the DPC selected the
+ * music stream's voice to queue its next buffer between a game thread's
+ * SET_CURRENT_VOICE and its volume writes for a sound effect, and the effect's
+ * volumes (and other state) landed on the music voice. Amped 2's music went
+ * mono, quiet or silent and stopped after a track; static and a crash
+ * followed.
+ *
+ * So a thread holds this lock from the moment its IRQL reaches
+ * DISPATCH_LEVEL until it drops below, and a DPC (entered at DISPATCH_LEVEL
+ * through xbox_IrqlEnterInterrupt) takes it too. ISRs do not: device IRQLs
+ * preempt DISPATCH_LEVEL code on hardware as well, and the device models
+ * already hold interrupts off while any thread is raised.
+ *
+ * A thread that raises and never lowers would stall DPCs for good, so the
+ * DPC side gives up waiting after RECOMP_DISPATCH_LOCK_MS (default 100) and
+ * runs anyway, saying so. RECOMP_DISPATCH_LOCK=0 turns the lock off. */
+void xbox_IrqlDumpHolders(void);
+static CRITICAL_SECTION s_dispatch_cs;
+static volatile LONG s_dispatch_init;           /* 0 no, 1 initialising, 2 yes */
+static int s_dispatch_on = -1, s_dispatch_wait_ms = 100;
+static XBOX_THREAD_LOCAL int t_dispatch_held;   /* this thread holds the lock */
+static XBOX_THREAD_LOCAL int t_in_isr;          /* inside a device-level ISR */
+static XBOX_THREAD_LOCAL int t_entering_dpc;    /* xbox_IrqlEnterInterrupt(2) */
+
+static int dispatch_lock_on(void)
+{
+    if (s_dispatch_on < 0) {
+        const char *e = getenv("RECOMP_DISPATCH_LOCK");
+        const char *w = getenv("RECOMP_DISPATCH_LOCK_MS");
+        if (w && *w)
+            s_dispatch_wait_ms = atoi(w);
+        s_dispatch_on = !(e && *e == '0');
+    }
+    if (s_dispatch_on && InterlockedCompareExchange(&s_dispatch_init, 0, 0) != 2) {
+        if (InterlockedCompareExchange(&s_dispatch_init, 1, 0) == 0) {
+            InitializeCriticalSection(&s_dispatch_cs);
+            InterlockedExchange(&s_dispatch_init, 2);
+        }
+        while (InterlockedCompareExchange(&s_dispatch_init, 0, 0) != 2)
+            Sleep(0);
+    }
+    return s_dispatch_on;
+}
+
+static void dispatch_lock_take(void)
+{
+    if (t_in_isr || !dispatch_lock_on())
+        return;
+    if (t_entering_dpc) {
+        /* A DPC waits for raised threads, but not forever. */
+        DWORD t0 = GetTickCount();
+        while (!TryEnterCriticalSection(&s_dispatch_cs)) {
+            if ((int)(GetTickCount() - t0) >= s_dispatch_wait_ms) {
+                static volatile LONG warned;
+                if (InterlockedIncrement(&warned) <= 5) {
+                    fprintf(stderr, "  [IRQL] a DPC waited %d ms for a thread at "
+                                    "raised IRQL; running it anyway\n",
+                            s_dispatch_wait_ms);
+                    xbox_IrqlDumpHolders();
+                }
+                return;
+            }
+            Sleep(0);
+        }
+    } else {
+        EnterCriticalSection(&s_dispatch_cs);
+    }
+    t_dispatch_held = 1;
+}
+
+static void dispatch_lock_drop(void)
+{
+    if (t_dispatch_held) {
+        t_dispatch_held = 0;
+        LeaveCriticalSection(&s_dispatch_cs);
+    }
+}
