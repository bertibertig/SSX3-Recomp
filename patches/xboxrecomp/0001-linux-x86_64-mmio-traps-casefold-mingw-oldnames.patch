+/* The same pool on POSIX hosts, over pthreads.
+ *
+ * It used to exist on Windows only, and every POSIX build rasterised on the
+ * executor thread alone: SSX 3's front end ran at 1.5 fps on Linux and
+ * 7-13 fps under Proton from the same source, with the title's two D3D
+ * threads spinning on the GPU the whole time. Same split as above -- worker
+ * k takes rows miny+k, miny+k+n, ...; the caller takes the last share. A
+ * generation counter under one mutex starts a round, so a worker that is
+ * slow to wake still runs exactly once per triangle. */
+#include <pthread.h>
+#include <unistd.h>
+
+static struct {
+    int n;                                  /* threads incl. the caller */
+    pthread_mutex_t mu;
+    pthread_cond_t go, done;
+    unsigned gen;                           /* bumped once per triangle */
+    int pending;
+    const XfTri *tri;
+    XfCount cnt[NV_RASTER_MAX_THREADS];
+} s_pool = { 0, PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER,
+             PTHREAD_COND_INITIALIZER, 0, 0, NULL, {{0, 0, 0}} };
+
+static void *raster_worker(void *arg)
+{
+    int k = (int)(intptr_t)arg;
+    unsigned seen = 0;
+
+    for (;;) {
+        const XfTri *T;
+
+        pthread_mutex_lock(&s_pool.mu);
+        while (s_pool.gen == seen)
+            pthread_cond_wait(&s_pool.go, &s_pool.mu);
+        seen = s_pool.gen;
+        T = s_pool.tri;
+        pthread_mutex_unlock(&s_pool.mu);
+
+        memset(&s_pool.cnt[k], 0, sizeof s_pool.cnt[k]);
+        xf_rows(T, T->miny + k, s_pool.n, &s_pool.cnt[k]);
+
+        pthread_mutex_lock(&s_pool.mu);
+        if (--s_pool.pending == 0)
+            pthread_cond_signal(&s_pool.done);
+        pthread_mutex_unlock(&s_pool.mu);
+    }
+    return NULL;
+}
+
+static int raster_pool_size(void)
+{
+    static int init;
+    if (!init) {
+        const char *e = getenv("RECOMP_RASTER_THREADS");
+        long cpus = sysconf(_SC_NPROCESSORS_ONLN);
+        int n, k;
+        init = 1;
+        n = e ? atoi(e) : (int)cpus - 4;
+        if (n < 1) n = 1;
+        if (n > NV_RASTER_MAX_THREADS) n = NV_RASTER_MAX_THREADS;
+        s_pool.n = 1;
+        for (k = 0; k < n - 1; k++) {
+            pthread_t th;
+            if (pthread_create(&th, NULL, raster_worker,
+                               (void *)(intptr_t)k) != 0)
+                break;
+            pthread_detach(th);
+        }
+        s_pool.n = k + 1;                   /* the workers that started */
+        fprintf(stderr, "  [GPU] rasteriser: %d thread(s)\n", s_pool.n);
+    }
+    return s_pool.n;
+}
