+    if (oa->RootDirectory && xbox_path[0] != '\\'
+            && !(xbox_path[0] && xbox_path[1] == ':')) {
+        const char* base = w32_handle_path(oa->RootDirectory);
+        size_t dir;
+        char* p;
+
+        if (!base)
+            return 0;
+        dir = strlen(base);
+        while (dir > 1 && base[dir - 1] == '/')
+            dir--;
+        if (dir + 1 + strlen(xbox_path) >= n)
+            return 0;
+        memcpy(host_path, base, dir);
+        host_path[dir] = '/';
